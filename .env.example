# Copy to .env and adjust: cp .env.example .env

# Service

# Address the REST API listens on.
LEDGER_HTTP_ADDR=:8080

# Address the gRPC API listens on.
LEDGER_GRPC_ADDR=:9090

# Log verbosity: debug, info, warn, error.
LEDGER_LOG_LEVEL=info

# Log encoding: text for humans, json for a log aggregator.
LEDGER_LOG_FORMAT=text

# How long a request may run before the server abandons it.
LEDGER_REQUEST_TIMEOUT=15s

# How long in-flight requests get to finish after a shutdown signal.
LEDGER_SHUTDOWN_TIMEOUT=20s

# PostgreSQL

# Full connection URL for local development.
LEDGER_POSTGRES_URL=postgres://ledger:ledger_dev_password@localhost:5432/ledger?sslmode=disable

# Maximum pooled connections.
LEDGER_POSTGRES_MAX_CONNS=20

# Minimum idle connections kept warm.
LEDGER_POSTGRES_MIN_CONNS=2

# Recycle connections at this age.
LEDGER_POSTGRES_MAX_CONN_LIFETIME=1h

# Redis (saga worker lease, best effort)

LEDGER_REDIS_ADDR=localhost:6379
LEDGER_REDIS_DB=0
# Leave empty for a local container with no auth.
LEDGER_REDIS_PASSWORD=

# Compose-only settings (read by docker-compose.yml, not by the service)

POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger_dev_password
POSTGRES_DB=ledger
POSTGRES_PORT=5432

REDIS_PORT=6379

LEDGER_HTTP_PORT=8080
LEDGER_GRPC_PORT=9090
LEDGER_DEBUG_PORT=2345

# Stamped into the binary and reported by the version endpoint.
VERSION=dev
